{
  "name": "xuna-desktop",
  "productName": "XUNA AI",
  "version": "1.0.2",
  "description": "XUNA AI for Windows",
  "author": "XUNA AI",
  "license": "UNLICENSED",
  "private": true,
  "repository": "github:clementxuna/xuna-desktop-app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.10"
  },
  "build": {
    "appId": "ai.xuna.desktop",
    "copyright": "Copyright © XUNA AI",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "XUNA-AI-Setup.${ext}",
      "uninstallDisplayName": "${productName}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "clementxuna",
        "repo": "xuna-desktop-app",
        "releaseType": "draft"
      }
    ]
  }
}
