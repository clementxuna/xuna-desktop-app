<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's helper processes (pages, GPU, audio). Same as the app's entitlements, without the push ones:
       macOS stops a helper that claims them, because the provisioning profile covers only the app itself. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Voice agents use the microphone. The app never asks for the camera. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
