<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine compiles code at run time, which the hardened runtime blocks without these. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Voice agents use the microphone. The app never asks for the camera. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Push notifications from XUNA's servers through Apple (APNs). macOS allows these only because the provisioning
       profile embedded in the app (build/developer-id.provisionprofile) grants them to this app ID. Helper processes
       use entitlements.mac.inherit.plist, without them. -->
  <key>com.apple.developer.aps-environment</key>
  <string>production</string>
  <key>com.apple.application-identifier</key>
  <string>57JSRUV65Y.ai.xuna.desktop</string>
  <key>com.apple.developer.team-identifier</key>
  <string>57JSRUV65Y</string>
</dict>
</plist>
